# TMDB metadata API configuration.
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. Nothing here may be hardcoded in source code.

# TMDB API key used by the server for metadata fetching.
# SERVER-ONLY — never reference in client code, never prefix with NEXT_PUBLIC_.
TMDB_API_KEY=

# TMDB API base URL (server-side).
TMDB_API_URL=https://api.themoviedb.org/3

# Default language passed to TMDB queries (e.g. en, de, es, fr, pt).
NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE=en

# TMDB image CDN base URL (public, safe for the browser).
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Image proxy settings (wsrv.nl or custom proxy; set to false to use raw CDN directly)
NEXT_PUBLIC_ENABLE_IMAGE_PROXY=true
NEXT_PUBLIC_IMAGE_PROXY_URL=https://wsrv.nl

# SQLite database file path (SERVER-ONLY). Defaults to ./data/cineby.db.
DATABASE_PATH=data/cineby.db

# Redis (required for caching and security)
REDIS_URL=redis://localhost:6379

# Stream security secret (generate with: openssl rand -hex 32)
# Required for SSR token signing and proxy descriptors
STREAM_SECRET=your_64_char_hex_secret_here

# Cloudflare Worker Media / Stream Proxy URL (optional, for CORS & stream piping)
# Example: https://my-stream-proxy.workers.dev
STREAM_PROXY_URL=

# Proxy allowlist - comma-separated upstream CDN hostnames (required in production)
STREAM_PROXY_ALLOWED_HOSTS=cdn.vidy.st,cdn.vidking.net,subtitles.vidy.st,subs.videasy.to

# Required in production for signed stream proxy descriptors.
STREAM_PROXY_SECRET=
STREAM_PROXY_ALLOWED_HOSTS=

# Stream Provider Toggles (optional, true/false)
# ENABLE_VIDY=true
# ENABLE_VIDKING=false
# ENABLE_VIXSRC=false


