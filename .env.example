# TMDB metadata API configuration.
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. Nothing here may be hardcoded in source code.

# TMDB API key used by the server for metadata fetching.
# SERVER-ONLY — never reference in client code, never prefix with NEXT_PUBLIC_.
TMDB_API_KEY=

# TMDB API base URL (server-side).
TMDB_API_URL=https://api.themoviedb.org/3

# Default language passed to TMDB queries (e.g. en, de, es, fr, pt).
NEXT_PUBLIC_TMDB_DEFAULT_LANGUAGE=en

# TMDB image CDN base URL (public, safe for the browser).
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# SQLite database file path (SERVER-ONLY). Defaults to ./data/cineby.db.
DATABASE_PATH=data/cineby.db